# 复制为 .env 后按需修改（.env 不会被提交到 Git）
# ---------------- 检索参数 ----------------
TOP_K=4
MIN_SCORE=0.22
MIN_COVERAGE=0.20
CHUNK_SIZE=300
CHUNK_OVERLAP=60
# KNOWLEDGE_DIR=data/knowledge

# ---------------- 大模型（可选）----------------
# 不配置也能跑：默认使用内置的抽取式回答，完全离线
USE_LLM=false
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=doubao-seed-1-6-250615
LLM_TEMPERATURE=0.2